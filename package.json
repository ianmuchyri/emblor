{
  "name": "emblor",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prettier-check": "prettier --check \"**/*.{ts,tsx,md}\"",
    "release": "npm run build && changeset publish",
    "local-release": "changeset version && changeset publish",
    "prepublishOnly": "npm run ci",
    "copy-readme": "cp README.md packages/*",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianmuchyri/emblor.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "emblor",
    "shadcn",
    "react",
    "tag input",
    "shadcn/ui",
    "tag input component",
    "input",
    "radix ui",
    "react tag input",
    "emblor tag input react 19"
  ],
  "author": "Ian Muchiri",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@types/node": "22",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "tsc-files": "^1.1.4",
    "tsup": "^8.4.0",
    "turbo": "latest",
    "typescript": "5.8.2",
    "zod": "^3.24.2",
    "eslint": "^9.22.0"
  },
  "lint-staged": {
    "*.{ts,tsx,md,mdx}": [
      "prettier --write",
      "tsc-files --noEmit"
    ],
    "*.{js,jsx,json}": [
      "prettier --write"
    ]
  },
  "trustedDependencies": [
    "npm-run-all"
  ],
  "dependencies": {
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1"
  }
}
